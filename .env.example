# AegisZero — local configuration
# Copy to .env for local development. In Vercel add the same names under
# Settings > Environment Variables.

# These three are Vite build-time values: they are compiled into the public bundle, so
# add them as type "Config", not "Secret", and redeploy after changing them.
#
# Supabase (Project Settings > API). Same project as your other apps, so one account
# works everywhere. Without these the console runs guest-only and nothing is persisted.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: only set this if the dispatch service is hosted on another origin.
# VITE_API_BASE=https://your-app.vercel.app/api

# ---------------------------------------------------------------------------
# Server-side only. These belong to the dispatch function in api/, never to the
# browser. Add them in Vercel as type "Secret" — they are not read by Vite, so
# putting them in this file has no effect on a production build.
#
# The webhook URL embeds a tenant token that authorises access-revocation calls.
# It used to be VITE_WORKATO_WEBHOOK_URL, which meant every visitor could read it
# out of the shipped bundle. Keep it off any VITE_ prefix.
#
#   WORKATO_WEBHOOK_URL=https://webhooks.workato.com/webhooks/rest/<token>/employee_transfer
#   SUPABASE_URL=...            # same value as VITE_SUPABASE_URL
#   SUPABASE_ANON_KEY=...       # same public anon key; used only to verify a caller's token
#
# Without WORKATO_WEBHOOK_URL the console still renders; dispatch answers 503 and
# says so. Without SUPABASE_URL/SUPABASE_ANON_KEY dispatch answers 401, because it
# cannot confirm who is asking.
