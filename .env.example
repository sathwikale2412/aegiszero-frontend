# AegisZero — local configuration
# Copy to .env for local development. In Vercel add the same names under
# Settings > Environment Variables (type "Config" so Vite can inline them).

# Supabase (Project Settings > API). Same project as your other apps, so one
# account works everywhere. Without these the console runs guest-only and
# nothing is persisted.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Workato inbound webhook. This URL contains a tenant token, so it must NOT be
# committed — and rotate the webhook if an old one ever reached a public repo.
# Without it the console renders, shows "Webhook not configured", and refuses to dispatch.
VITE_WORKATO_WEBHOOK_URL=https://webhooks.workato.com/webhooks/rest/<your-token>/employee_transfer
